{
  "schema": 1,
  "plugins": [
    {
      "id": "bash",
      "build": {
        "runner": "windows-latest",
        "command": [
          "pwsh",
          "-NoProfile",
          "-File",
          "plugins/bash/workflow/build.ps1",
          "-Output",
          "{output}"
        ]
      },
      "smoke": {
        "runner": "windows-latest",
        "probe": {
          "kind": "command",
          "path": "payload/usr/bin/bash.exe",
          "args": [
            "--noprofile",
            "--norc",
            "-lc",
            "test -n \"$BASH_VERSION\" && printf cgm-bash-install-smoke"
          ],
          "stdout": "cgm-bash-install-smoke"
        }
      }
    },
    {
      "id": "admin-ui",
      "core": {
        "required": false,
        "enabled": true
      },
      "build": {
        "runner": "ubuntu-latest",
        "command": [
          "node",
          "scripts/prepare-web-embed.mjs",
          "--output",
          "{output}"
        ]
      },
      "smoke": {
        "runner": "ubuntu-latest",
        "probe": {
          "kind": "file",
          "path": "payload/index.html"
        }
      }
    },
    {
      "id": "rtk",
      "build": {
        "runner": "ubuntu-latest",
        "mode": "manifest"
      }
    },
    {
      "id": "cf-tunnel",
      "build": {
        "runner": "ubuntu-latest",
        "command": [
          "go",
          "run",
          "./plugins/cf-tunnel/build",
          "-output",
          "{output}"
        ]
      },
      "smoke": {
        "runner": "ubuntu-latest",
        "probe": {
          "kind": "file",
          "path": "payload/cf-tunnel"
        }
      }
    },
    {
      "id": "secure-mcp-tunnel",
      "core": {
        "required": false,
        "enabled": true
      },
      "build": {
        "runner": "ubuntu-latest",
        "command": [
          "go",
          "run",
          "./plugins/secure-mcp-tunnel/build",
          "-output",
          "{output}"
        ]
      },
      "smoke": {
        "runner": "ubuntu-latest",
        "probe": {
          "kind": "file",
          "path": "payload/secure-mcp-tunnel"
        }
      }
    },
    {
      "id": "tui",
      "core": {
        "required": false,
        "enabled": true
      },
      "build": {
        "runner": "ubuntu-latest",
        "command": [
          "go",
          "run",
          "./plugins/tui/build",
          "-output",
          "{output}"
        ]
      },
      "smoke": {
        "runner": "ubuntu-latest",
        "probe": {
          "kind": "file",
          "path": "payload/tui"
        }
      }
    },
    {
      "id": "markdown-formatter",
      "core": {
        "required": false,
        "enabled": true
      },
      "build": {
        "runner": "ubuntu-latest",
        "command": [
          "go",
          "run",
          "./plugins/markdown-formatter/build",
          "-output",
          "{output}"
        ]
      },
      "smoke": {
        "runner": "ubuntu-latest",
        "probe": {
          "kind": "file",
          "path": "payload/markdown-formatter"
        }
      }
    },
    {
      "id": "ponytail",
      "core": {
        "required": false,
        "enabled": true
      },
      "build": {
        "runner": "ubuntu-latest",
        "command": [
          "go",
          "run",
          "./plugins/ponytail/build",
          "-output",
          "{output}"
        ]
      },
      "smoke": {
        "runner": "ubuntu-latest",
        "probe": {
          "kind": "file",
          "path": "payload/ponytail"
        }
      }
    },
    {
      "id": "caveman",
      "core": {
        "required": false,
        "enabled": true
      },
      "build": {
        "runner": "ubuntu-latest",
        "command": [
          "go",
          "run",
          "./plugins/caveman/build",
          "-output",
          "{output}"
        ]
      },
      "smoke": {
        "runner": "ubuntu-latest",
        "probe": {
          "kind": "file",
          "path": "payload/caveman"
        }
      }
    }
  ]
}
