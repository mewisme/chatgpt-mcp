[Unit]
Description=chatgpt-mcp cluster relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=chatgpt-mcp
Group=chatgpt-mcp
LoadCredential=cluster-token:/etc/chatgpt-mcp/cluster-relay.token
ExecStart=/usr/local/bin/cgm cluster relay --token-file %d/cluster-token --listen 127.0.0.1:37423
Restart=on-failure
RestartSec=2s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_INET AF_INET6

[Install]
WantedBy=multi-user.target